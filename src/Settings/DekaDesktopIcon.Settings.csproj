<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>DekaDesktopIcon.Settings</RootNamespace>
    <AssemblyName>DekaDesktopIcon.Settings</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Unpackaged, x64, self-contained .NET and Windows App SDK. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>

    <!-- UI is built in code; we supply our own Main and metadata provider. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <Product>DekaDesktopIcon</Product>
    <AssemblyTitle>DekaDesktopIcon 設定</AssemblyTitle>
    <Copyright>Copyright (c) 2026 sh4</Copyright>
    <Version>1.5.0</Version>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(DekaWindowsAppSdkVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Pinned stable Windows App SDK. Override with -p:DekaWindowsAppSdkVersion=X only with evidence. -->
    <DekaWindowsAppSdkVersion Condition="'$(DekaWindowsAppSdkVersion)' == ''">2.7.0</DekaWindowsAppSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Development-only fake native controller lives in its own project. -->
    <Compile Remove="Tools\**" />
    <None Remove="Tools\**" />
    <Content Remove="Tools\**" />
  </ItemGroup>

</Project>
